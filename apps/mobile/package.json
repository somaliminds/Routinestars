    "@testing-library/react-native": "^13.2.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/react": "~19.1.10",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.6",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
